{
  "name": "signal-radar",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source anomaly radar: public raw data, zero trust, convergence instead of headlines.",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "collect": "node src/cli.ts collect",
    "snapshot": "node src/cli.ts snapshot",
    "run": "node src/cli.ts run",
    "replay": "SR_FIXTURES=replay node src/cli.ts run --now-from-fixtures",
    "serve": "node scripts/serve.ts"
  }
}
